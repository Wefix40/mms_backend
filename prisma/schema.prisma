// use prisma-next

model User {
  id              Uuid              @id @default(uuid())
  name            String
  email           String            @unique
  phone           String?
  passwordHash    String            @map("password_hash")
  roleId          Uuid              @map("role_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @map("updated_at")

  role            Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  userPermissions UserPermission[]

  @@map("users")
}

model Role {
  id              Uuid              @id @default(uuid())
  name            String            @unique
  description     String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Menu {
  id              Uuid              @id @default(uuid())
  label           String
  route           String?
  icon            String
  parentId        Uuid?             @map("parent_id")
  sequence        Int

  parent          Menu?             @relation("MenuToMenu", fields: [parentId], references: [id])
  children        Menu[]            @relation("MenuToMenu")
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("menus")
}

model RolePermission {
  roleId          Uuid              @map("role_id")
  menuId          Uuid              @map("menu_id")
  canView         Boolean           @default(false) @map("can_view")
  canCreate       Boolean           @default(false) @map("can_create")
  canEdit         Boolean           @default(false) @map("can_edit")
  canDelete       Boolean           @default(false) @map("can_delete")

  role            Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu            Menu              @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@map("role_permissions")
}

model UserPermission {
  userId          Uuid              @map("user_id")
  menuId          Uuid              @map("menu_id")
  canView         Boolean           @map("can_view")
  canCreate       Boolean           @map("can_create")
  canEdit         Boolean           @map("can_edit")
  canDelete       Boolean           @map("can_delete")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  menu            Menu              @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([userId, menuId])
  @@map("user_permissions")
}
